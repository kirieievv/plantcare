rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Owner of the plant a subcollection hangs off. Costs one document read per
    // rule evaluation, which is the price of keeping ownership on the parent
    // instead of denormalising userId onto every fact.
    function ownsPlant(plantId) {
      return request.auth != null
        && get(/databases/$(database)/documents/plants/$(plantId)).data.userId == request.auth.uid;
    }

    // The admin panel (plant_care_admin) reads the database with the ordinary
    // client SDK, so the rules have to know about it. Its own check is a string
    // comparison in the browser — a gate on the interface, not on the data,
    // which held only while the database was open to everyone.
    //
    // By uid rather than by email. An email would work today, but it leans on
    // the project keeping one account per address, and it stops being true the
    // day the address changes. Neither the uid nor the email is a secret: what
    // stands between a stranger and this is Firebase refusing to issue a token
    // for an account whose password they do not have.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'oAbaAldoRLgAJ7j80uAWHSUODDt1';
    }

    // Per-user document, plus everything nested under it — plant_chats/{plantId}/
    // messages/{messageId} and chat_quotas/{plantId} both live here (confirmed in
    // lib/screens/plant_chat_screen.dart). Owner-only, both directions: the client
    // writes its own profile fields and chat messages directly, and reads its own
    // quota. Firestore rules are NOT inherited by subcollections automatically —
    // the nested {document=**} match is what covers plant_chats/messages/chat_quotas
    // at any depth under this user.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // The panel lists every user and edits subscription status by hand when a
      // webhook is missed. Not narrowed to those fields: rules cannot express
      // "only these keys" without listing every other one, and a list that goes
      // stale silently is worse than none.
      allow read, write: if isAdmin();

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Plants: owner CRUD directly from the client (add/edit/delete their own
    // plants — confirmed in lib/screens/add_plant_screen.dart and friends).
    match /plants/{plantId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Read only: the panel lists plants, it never edits one.
      allow read: if isAdmin();
    }

    // Assistant memory — what the app knows about a plant beyond its own fields.
    //
    // Facts are extracted server-side from what the owner says in chat, so the
    // client never creates or edits them: a client-side write here would let
    // anyone plant a belief the assistant then repeats as established truth.
    // Delete is the deliberate exception — the "what the assistant knows" screen
    // has to be able to actually forget something, or a wrong fact is
    // undebuggable for the user and for us.
    match /plants/{plantId}/facts/{factId} {
      allow read, delete: if ownsPlant(plantId);
      allow create, update: if false;
    }

    // Rolling summary and the single pending question. A projection of the facts
    // above, rebuilt server-side — read-only for the client.
    match /plants/{plantId}/memory/{docId} {
      allow read: if ownsPlant(plantId);
      allow write: if false;
    }

    // Health checks: owner CRUD. Tempting to lock writes to the Admin SDK —
    // a client that can write here can fabricate its own diagnosis — but in
    // this app the client IS the writer: HealthCheckService.addHealthCheck
    // does the .set() straight from health_check_modal.dart after a scan.
    // Denying create here does not harden anything, it deletes the feature.
    // The blast radius of the write is the user's own plant either way.
    match /health_checks/{checkId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
    }

    // Watering events — this rule was already correct, it was just silently
    // overridden by the wildcard block at the bottom of the old file (Firestore
    // rules are OR'd across every matching block for a given path, so a
    // permissive wildcard anywhere defeats every stricter rule above it).
    match /watering_events/{eventId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Care tasks: a user only ever sees and edits their own. Unlike health_checks
    // this one stays client-writable — TaskService.createFromAnalysis creates
    // analysis tasks from the app, and the user completes and postpones them.
    match /tasks/{taskId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // FCM tokens: doc id is the token string itself, userId lives in the body
    // (lib/services/notification_service.dart sets and deletes by token id
    // straight from the client). It also queries its own tokens back to count
    // them after registering, so read has to be allowed for the owner — a blanket
    // read:false there fails silently inside a try/catch and the only symptom is
    // a wrong token count nobody looks at.
    match /fcm_tokens/{token} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
    }

    // Global, non-personal content: any signed-in user may read; nobody writes
    // from the client (server-managed — seasonal_tips by a scheduled Function,
    // app_config by hand/admin tooling).
    match /seasonal_tips/{weekKey} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /app_config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
      // Trial length and plant limits are edited from the panel's Subscription
      // page, and every client reads them back on launch.
      allow write: if isAdmin();
    }

    // Pure server-internal collections — no client access at all, in either
    // direction. password_reset_codes / email_verification_pins / mail are
    // actively dangerous if client-readable or -writable (account takeover /
    // spam-relay vectors), not just "shouldn't be touched".
    // Readable by the panel, which is what Stats and Logs are built on. Writing
    // stays shut to everyone including the admin: these are records of what the
    // system did, and a record you can edit is not a record.
    match /ai_usage/{docId} { allow read: if isAdmin(); allow write: if false; }
    match /ai_usage_daily/{docId} { allow read: if isAdmin(); allow write: if false; }
    match /push_notifications/{docId} { allow read: if isAdmin(); allow write: if false; }
    // This one carries the password-reset messages, so reading it is effectively
    // access to every account. Granted knowingly: the Logs page is wanted whole.
    match /mail/{docId} { allow read: if isAdmin(); allow write: if false; }
    match /password_reset_codes/{docId} { allow read, write: if false; }
    match /email_verification_pins/{docId} { allow read, write: if false; }
    match /scheduled_test_pushes/{docId} { allow read, write: if false; }
    // Holds weather_health, which is how an outage at the weather provider
    // becomes visible instead of only reaching Cloud Logging. Written by the
    // Admin SDK, which these rules do not apply to.
    match /system/{docId} { allow read: if isAdmin(); allow write: if false; }

    // Everything else: closed by default. The previous
    // `match /{document=**} { allow read, write: if true; }` here was the actual
    // hole — it silently granted access to every collection above too (rules are
    // OR'd, not first-match-wins), regardless of how tight the specific rules
    // were. Add a specific `match` block above for any new collection instead of
    // loosening this one.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
